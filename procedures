CREATE PROCEDURE gerenciar_membros_grupo (IN grupo INT, IN id_admin INT, IN membro INT, IN novo_status TEXT)
BEGIN

DECLARE eh_admin INT DEFAULT 0;

IF verificar_status_grupo(grupo) = FALSE THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'ERRO: Esse grupo não existe ou foi desativado'
END;

SELECT COUNT(*) INTO eh_admin
FROM grupo_membros
WHERE id_grupo = grupo AND id_usuario = id_admin AND cargo = 'admin'

IF eh_admin = 0 THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'ERRO: Somento o administrador do grupo pode fazer modificações';
END IF;

IF novo_status = 'ativo' THEN
    INSERT INTO grupo_membros (id_grupo, id_usuario, cargo, status_membro)
    VALUES (grupo, membro, 'membro', 'ativo')
    ON DUPLICATED KEY UPDATE status_membro = 'ativo';
END IF;

IF novo_status = 'expulso' THEN
    UPDATE grupo_membros
    SET status_membro = 'expulso'
    WHERE id_grupo = grupo AND id_usuario = membro
END IF;

END;



