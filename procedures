CREATE PROCEDURE mensagem_broadcast(IN lista_grupos VARCHAR(500), IN mensagem TEXT, IN remetente INT)
BEGIN

DECLARE idGrupo INT;
DECLARE posicao INT;
DECLARE eh_membro INT DEFAULT 0;
DECLARE status_atual VARCHAR(20) DEFAULT '';

SET lista_grupos = CONCAT(lista_grupos, ',');

WHILE LENGTH(lista_grupos) > 0 DO 
    SET posicao = LOCATE(',', lista_grupos);
    SET idGrupo = CAST(SUBSTRING(lista_grupos, 1, posicao - 1) AS UNSIGNED);
    SET lista_grupos = SUBSTRING(lista_grupos, posicao + 1);

    SET eh_membro = 0;
    SET status_atual = NULL;

    IF verificar_status_grupo(idGrupo) = FALSE THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'ERRO: Esse grupo não existe ou foi desativado'
END;

SELECT COUNT(*), status_membro INTO eh_membro, status_atual
FROM grupo_membros
WHERE id_grupo = grupo AND id_usuario = remetente;

IF eh_membro = 0 OR status_atual = 'expulso' OR status_atual = 'saiu' THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'ERRO: Você não pode enviar mensagem para esse grupo';
END IF;

INSERT INTO mensagens (id_conversa, id_grupo, remetente_id, conteudo) 
VALUES (NULL, grupo, remetente, mensagem);

END;

