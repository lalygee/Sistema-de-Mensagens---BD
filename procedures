CREATE TRIGGER trg_valida_cpf
BEFORE INSERT ON usuarios
FOR EACH ROW
BEGIN

DECLARE qtd_total INT;
DECLARE qtd_tipo INT;
DECLARE hash_calculado VARCHAR(64);

SET hash_calculado = SHA2(CONCAT(new.cpf, new.cpf_salt), 256);

SELECT COUNT(*) INTO qtd_total
FROM usuarios
WHERE cpf_hash = hash_calculado;

IF qtd_total >= 2 THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'ERRO: Limite máximo de contas por CPF alcançado'
END IF;

SELECT COUNT(*) INTO qtd_tipo
FROM usuarios
WHERE cpf_hash = hash_calculado AND tipo_usuario = new.tipo_usuario

IF qtd_tipo > 0 THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'ERRO: Este CPF já possui uma conta cadastrada para esse tipo'
END IF;
    
END;


