CREATE PROCEDURE ativacao_contas_gestor(IN gestor INT, IN id_conta INT)
BEGIN

DECLARE ehgestor INT;
DECLARE status_atual BOOLEAN;

SELECT COUNT(*) INTO ehgestor
FROM usuarios
WHERE id_usuario = gestor AND tipo_usuario = 'gestor';

IF ehgestor = 0 THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'ERRO: Apenas o administrador do aplicativo pode fazer essa ação';
END IF;

SELECT ativo INTO status_atual
FROM usuarios
WHERE id_usuario = id_conta;

IF status_atual IS NULL THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'ERRO: Conta não encontrada';
END IF;

IF status_atual = TRUE THEN
    UPDATE usuarios
    SET ativo = FALSE
    WHERE id_usuario = id_conta;
ELSE
    UPDATE usuarios
    SET ativo = TRUE
    WHERE id_usuario = id_conta;
END IF;

END;



