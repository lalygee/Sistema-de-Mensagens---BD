CREATE PROCEDURE enviar_mensagem_privada(IN remetente INT, IN destinatario INT, IN mensagem TEXT)
BEGIN

DECLARE possivel_conversa INT;

IF remetente = destinatario THEN
    SELECT id_conversa INTO possivel_conversa
    FROM conversas c 
    JOIN conversa_participantes cp ON c.id_conversa = cp.id_conversa
    WHERE c.tipo = 'privado' AND cp.id_usuario = remetente
    GROUP BY c.id_conversa
    HAVING COUNT(cp.id_usuario) = 1
    LIMIT 1;
ELSE
    SELECT c.id_conversa INTO possivel_conversa
    FROM conversas c
    JOIN conversa_participantes c1 ON c.id_conversa = c1.id_conversa AND c1.id_usuario = remetente
    JOIN conversa_participantes c2 ON c.id_conversa = c2.id_conversa AND c2.id_usuario = destinatario
    WHERE c.tipo = 'privado'
    LIMIT 1;

IF possivel_conversa IS NULL THEN

    INSERT INTO conversas (tipo) VALUES ('privado');
    SET possivel_conversa = LAST_INSERT_ID();

    IF remetente = destinatario THEN
        INSERT INTO conversa_participantes (id_conversa, id_usuario) VALUES (possivel_conversa, remetente);
    ELSE
        INSERT INTO conversa_participantes (id_conversa, id_usuario) VALUES (possivel_conversa, remetente);
        INSERT INTO conversa_participantes (id_conversa, id_usuario) VALUES (possivel_conversa, destinatario);
    END IF;
END IF;

INSERT INTO mensagens (id_conversa, id_grupo, remetente_id, conteudo) VALUES (possivel_conversa, NULL, remetente, mensagem);

END;

CREATE FUNCTION verificar_status_grupo(grupo INT)
RETURN BOOLEAN
DETERMINISTIC
BEGIN
    DECLARE grupo_ativo BOOLEAN

    SELECT ativo INTO grupo_ativo
    FROM grupos
    WHERE id_grupo = grupo;

    IF grupo_ativo IS NULL OR grupo_ativo = FALSE THEN
        RETURN FALSE;
    ELSE 
        RETURN TRUE;
    END IF;
END;


CREATE PROCEDURE enviar_mensagem_grupo(IN remetente INT, IN grupo INT, IN mensagem TEXT)
BEGIN

DECLARE eh_membro INT DEFAULT 0;
DECLARE status_atual VARCHAR(20) DEFAULT '';

IF verificar_status_grupo(grupo) = FALSE THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'ERRO: Esse grupo não existe ou foi desativado'
END;

SELECT COUNT(*), status_membro INTO eh_membro, status_atual
FROM grupo_membros
WHERE id_grupo = grupo AND id_usuario = membro;

IF eh_membro = 0 OR status_atual = 'expulso' OR status_atual = 'saiu' THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'ERRO: Você não pode enviar mensagem para esse grupo';
END IF;

INSERT INTO mensagens (id_conversa, id_grupo, remetente_id, conteudo) 
VALUES (NULL, grupo, remetente, mensagem);

END;


