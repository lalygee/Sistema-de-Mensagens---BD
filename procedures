CREATE PROCEDURE criar_aceitar_amizade(IN usuarioA INT, IN usuarioB INT)
BEGIN

DECLARE verificar_amizade INT;
DECLARE status_prc_amizade BOOLEAN;

IF usuarioA = usuarioB THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'ERRO: Você não pode enviar um pedido de amizade para si mesmo'
END IF;

SELECT COUNT(*),  status_amizade INTO verificar_amizade, status_prc_amizade
FROM amizades
WHERE (id_usuarioA = usuarioA AND id_usuarioB = usuarioB) OR (id_usuarioB = usuarioB AND id_usuarioA = usuarioA);

IF verificar_amizade = 0 THEN
    INSERT INTO amizades(id_usuarioA, id_usuarioB, status_amizade)
    VALUES (usuarioA, usuarioB, FALSE);

ELSEIF verificar_amizade = FALSE THEN
    UPDATE amizades
    SET status_amizade = TRUE
    WHERE (id_usuarioA = usuarioA AND id_usuarioB = usuarioB) OR (id_usuarioB = usuarioB AND id_usuarioA = usuarioA);

ELSE
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'ERRO: Vocês já são amigos.'
END IF;

END;




