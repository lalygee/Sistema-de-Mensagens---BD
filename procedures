CREATE PROCEDURE alterar_dados(IN novo_nome VARCHAR(100), IN novo_email VARCHAR(100), IN nova_senha VARCHAR(255), IN usuario INT)
BEGIN 

SET @novo_salt_senha = SUBSTRING(MD5(RAND()), 1, 16); 

UPDATE usuarios
SET nome = novo_nome, email = novo_email, senha_hash = SHA2(CONCAT(nova_senha, @novo_salt_senha), 256), senha_salt = @novo_salt_senha 
WHERE id_usuario = usuario;

END;


